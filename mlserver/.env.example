# ─── NutriNavigator ML Server — Environment Variables ────────────────────────
# Copy this file to .env and fill in your values.
# The server reads these at startup; none are required (all have defaults).

# Port to listen on (default: 5000)
PORT=5000

# API key
ML_SECRET=random_secret_keys_here
# Set to 'development' to enable Flask debug mode and hot-reload.
# NEVER set to 'development' in production.
FLASK_ENV=production

# Frontend origin allowed for CORS (default: http://localhost:3000)
ALLOWED_ORIGIN=http://localhost:3000
