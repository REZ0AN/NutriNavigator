# ─── Application ──────────────────────────────────────────────────────────────
PORT=4080
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/nutri-navigator

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# ─── Bcrypt ───────────────────────────────────────────────────────────────────
SALT=10

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_API_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_MAIL=your_email@gmail.com
SMTP_PASS=your_app_password

# ─── Frontend ─────────────────────────────────────────────────────────────────
# No trailing slash. Used for CORS and password reset emails.
FRONT_END_URI=http://localhost:3000
ML_SECRET=<>
ML_SERVER_URL=<>
